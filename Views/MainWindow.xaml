<ui:FluentWindow x:Class="R6Tools.Views.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
		xmlns:viewmodels="clr-namespace:R6Tools.ViewModels"
		mc:Ignorable="d"
		Title="Rainbow Six Siege Tools" 
		Height="860" Width="580"
		MinHeight="700" MinWidth="540"
		WindowStartupLocation="CenterScreen"
		ExtendsContentIntoTitleBar="True"
		WindowBackdropType="None"
		Background="{StaticResource TossGrey50Brush}"
		FontFamily="{StaticResource TossFontFamily}">

	<Window.DataContext>
		<viewmodels:MainViewModel />
	</Window.DataContext>

	<Window.Resources>
		<BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

		<!-- 토스 미니멀 카드 스타일 (TDS radius-xl: 14px / 헤어라인 보더) -->
		<Style x:Key="TossCardBorder" TargetType="Border">
			<Setter Property="Background" Value="{StaticResource TossWhiteBrush}" />
			<Setter Property="BorderBrush" Value="{StaticResource TossGrey200Brush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="14" />
			<Setter Property="Padding" Value="18" />
			<Setter Property="Margin" Value="0,0,0,12" />
		</Style>

		<!-- 토스 세그먼트 탭 라디오 버튼 스타일 (큼직한 흰색 카드 하이라이트 + 그림자 + Toss Blue 텍스트) -->
		<Style x:Key="TossSegmentedTabStyle" TargetType="RadioButton">
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="VerticalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Foreground" Value="{StaticResource TossGrey600Brush}" />
			<Setter Property="FontSize" Value="12.5" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="RadioButton">
						<Border x:Name="tabBorder"
								Background="Transparent"
								CornerRadius="8"
								HorizontalAlignment="Stretch"
								VerticalAlignment="Stretch"
								Padding="2,0"
								Margin="1">
							<ContentPresenter HorizontalAlignment="Center" 
											  VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="tabBorder" Property="Background" Value="{StaticResource TossWhiteBrush}" />
								<Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource TossGrey200Brush}" />
								<Setter TargetName="tabBorder" Property="BorderThickness" Value="1" />
								<Setter TargetName="tabBorder" Property="Effect">
									<Setter.Value>
										<DropShadowEffect BlurRadius="5" ShadowDepth="1.5" Direction="270" Color="#191F28" Opacity="0.12" />
									</Setter.Value>
								</Setter>
								<Setter Property="Foreground" Value="{StaticResource TossBlueBrush}" />
								<Setter Property="FontWeight" Value="Bold" />
							</Trigger>
							<MultiTrigger>
								<MultiTrigger.Conditions>
									<Condition Property="IsMouseOver" Value="True" />
									<Condition Property="IsChecked" Value="False" />
								</MultiTrigger.Conditions>
								<Setter TargetName="tabBorder" Property="Background" Value="#E9ECEF" />
								<Setter Property="Foreground" Value="{StaticResource TossGrey900Brush}" />
							</MultiTrigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- 토스 프라이머리 CTA 버튼 스타일 (50px / TDS radius-l: 14px / 단일 Toss Blue) -->
		<Style x:Key="TossPrimaryButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="{StaticResource TossBlueBrush}" />
			<Setter Property="Foreground" Value="{StaticResource TossWhiteBrush}" />
			<Setter Property="FontSize" Value="15" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Height" Value="50" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border"
								Background="{TemplateBinding Background}"
								CornerRadius="14"
								SnapsToDevicePixels="True">
							<ContentPresenter HorizontalAlignment="Center" 
											  VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Background" Value="{StaticResource TossBluePressedBrush}" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="border" Property="Background" Value="{StaticResource TossBluePressedBrush}" />
								<Setter TargetName="border" Property="Opacity" Value="0.88" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="border" Property="Opacity" Value="0.30" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- 토스 세컨더리 버튼 스타일 (42px / TDS radius-m: 10px / Grey-100) -->
		<Style x:Key="TossSecondaryButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="{StaticResource TossGrey100Brush}" />
			<Setter Property="Foreground" Value="{StaticResource TossGrey800Brush}" />
			<Setter Property="FontSize" Value="14" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Height" Value="42" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border"
								Background="{TemplateBinding Background}"
								CornerRadius="10"
								SnapsToDevicePixels="True">
							<ContentPresenter HorizontalAlignment="Center" 
											  VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Background" Value="{StaticResource TossGrey200Brush}" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="border" Property="Opacity" Value="0.8" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="border" Property="Opacity" Value="0.35" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- 토스 스몰 액션 버튼 스타일 (36px / TDS radius-s: 8px) -->
		<Style x:Key="TossSmallButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="{StaticResource TossGrey100Brush}" />
			<Setter Property="Foreground" Value="{StaticResource TossGrey800Brush}" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Height" Value="36" />
			<Setter Property="Padding" Value="12,0" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border"
								Background="{TemplateBinding Background}"
								CornerRadius="8"
								Padding="{TemplateBinding Padding}"
								SnapsToDevicePixels="True">
							<ContentPresenter HorizontalAlignment="Center" 
											  VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Background" Value="{StaticResource TossGrey200Brush}" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="border" Property="Opacity" Value="0.8" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="border" Property="Opacity" Value="0.35" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- 토스 아웃라인 버튼 스타일 (명확히 클릭 가능한 버튼 시각화용) -->
		<Style x:Key="TossOutlineButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="{StaticResource TossWhiteBrush}" />
			<Setter Property="Foreground" Value="{StaticResource TossBlueBrush}" />
			<Setter Property="BorderBrush" Value="{StaticResource TossBlueBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Height" Value="36" />
			<Setter Property="Padding" Value="14,0" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="8"
								Padding="{TemplateBinding Padding}"
								SnapsToDevicePixels="True">
							<ContentPresenter HorizontalAlignment="Center" 
											  VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Background" Value="{StaticResource TossBlueWeakBrush}" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="border" Property="Opacity" Value="0.8" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="border" Property="Opacity" Value="0.35" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- 토스 칩/태그 버튼 스타일 (8px 단단한 사각 라운드 적용) -->
		<Style x:Key="TossPillChipStyle" TargetType="Button">
			<Setter Property="Background" Value="{StaticResource TossGrey100Brush}" />
			<Setter Property="Foreground" Value="{StaticResource TossGrey700Brush}" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Height" Value="30" />
			<Setter Property="Padding" Value="10,0" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Margin" Value="0,0,4,4" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border"
								Background="{TemplateBinding Background}"
								CornerRadius="8"
								Padding="{TemplateBinding Padding}"
								SnapsToDevicePixels="True">
							<ContentPresenter HorizontalAlignment="Center" 
											  VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Background" Value="{StaticResource TossBlueWeakBrush}" />
								<Setter Property="Foreground" Value="{StaticResource TossBlueBrush}" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="border" Property="Opacity" Value="0.8" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="border" Property="Opacity" Value="0.35" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- 토스 스텝 컴팩트 버튼 (+, - : 8px radius) -->
		<Style x:Key="TossCompactStepButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="{StaticResource TossGrey100Brush}" />
			<Setter Property="Foreground" Value="{StaticResource TossBlueBrush}" />
			<Setter Property="FontSize" Value="14" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Width" Value="34" />
			<Setter Property="Height" Value="34" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border"
								Background="{TemplateBinding Background}"
								CornerRadius="8"
								SnapsToDevicePixels="True">
							<ContentPresenter HorizontalAlignment="Center" 
											  VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Background" Value="{StaticResource TossBlueWeakBrush}" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="border" Property="Opacity" Value="0.75" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="border" Property="Opacity" Value="0.35" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- 토스 텍스트 입력창 스타일 (10px radius / Grey-100 배경) -->
		<Style x:Key="TossInputStyle" TargetType="TextBox">
			<Setter Property="Background" Value="{StaticResource TossGrey100Brush}" />
			<Setter Property="Foreground" Value="{StaticResource TossGrey900Brush}" />
			<Setter Property="BorderBrush" Value="{StaticResource TossGrey200Brush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Height" Value="38" />
			<Setter Property="Padding" Value="10,0" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border x:Name="border"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="10"
								SnapsToDevicePixels="True">
							<ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsFocused" Value="True">
								<Setter TargetName="border" Property="Background" Value="{StaticResource TossWhiteBrush}" />
								<Setter TargetName="border" Property="BorderBrush" Value="{StaticResource TossBlueBrush}" />
								<Setter TargetName="border" Property="BorderThickness" Value="1.5" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- 1. Window TitleBar -->
		<ui:TitleBar Title="R6 Tools" Grid.Row="0">
			<ui:TitleBar.Header>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<Button Grid.Column="1" 
							Command="{Binding RefreshDataCommand}" 
							Content="새로고침" 
							Style="{StaticResource TossSmallButtonStyle}" 
							Height="30" 
							Padding="12,0"
							Margin="0,0,12,0"/>
				</Grid>
			</ui:TitleBar.Header>
		</ui:TitleBar>

		<!-- 2. Header & TDS Segmented Control (선택된 탭 큼직한 흰색 하이라이트 + 그림자 + 잘림 방지 최적화) -->
		<StackPanel Grid.Row="1" Margin="16,6,16,10">
			<!-- Hero Title -->
			<TextBlock Text="필요한 설정을 한곳에서 편하게 바꿔요" 
					   FontSize="18" 
					   FontWeight="Bold" 
					   Foreground="{StaticResource TossGrey900Brush}" 
					   Margin="0,0,0,2" />
			<TextBlock Text="서버 변경, 감도 멀티플라이어, 동기화, 리플레이 보관 및 캐시 정리" 
					   FontSize="12" 
					   Foreground="{StaticResource TossGrey600Brush}" 
					   Margin="0,0,0,8" />

			<!-- TDS Segmented Control (트랙 전체를 꽉 채우는 큼직한 흰색 카드 하이라이트) -->
			<Border Background="{StaticResource TossGrey100Brush}" 
					CornerRadius="10" 
					Padding="3" 
					Height="44">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<!-- Tab 0: 서버 -->
					<RadioButton Grid.Column="0" 
								 GroupName="TdsTabs"
								 Content="서버"
								 IsChecked="{Binding IsServerTab, Mode=TwoWay}"
								 Command="{Binding SelectTabCommand}" 
								 CommandParameter="0"
								 Style="{StaticResource TossSegmentedTabStyle}" />

					<!-- Tab 1: 감도 · FPS -->
					<RadioButton Grid.Column="1" 
								 GroupName="TdsTabs"
								 Content="감도 · FPS"
								 IsChecked="{Binding IsMultiplierTab, Mode=TwoWay}"
								 Command="{Binding SelectTabCommand}" 
								 CommandParameter="1"
								 Style="{StaticResource TossSegmentedTabStyle}" />

					<!-- Tab 2: 동기화 -->
					<RadioButton Grid.Column="2" 
								 GroupName="TdsTabs"
								 Content="동기화"
								 IsChecked="{Binding IsBackupTab, Mode=TwoWay}"
								 Command="{Binding SelectTabCommand}" 
								 CommandParameter="2"
								 Style="{StaticResource TossSegmentedTabStyle}" />

					<!-- Tab 3: 리플레이 -->
					<RadioButton Grid.Column="3" 
								 GroupName="TdsTabs"
								 Content="리플레이"
								 IsChecked="{Binding IsReplayTab, Mode=TwoWay}"
								 Command="{Binding SelectTabCommand}" 
								 CommandParameter="3"
								 Style="{StaticResource TossSegmentedTabStyle}" />

					<!-- Tab 4: 캐시 정리 -->
					<RadioButton Grid.Column="4" 
								 GroupName="TdsTabs"
								 Content="캐시 정리"
								 IsChecked="{Binding IsCacheTab, Mode=TwoWay}"
								 Command="{Binding SelectTabCommand}" 
								 CommandParameter="4"
								 Style="{StaticResource TossSegmentedTabStyle}" />
				</Grid>
			</Border>
		</StackPanel>

		<!-- 3. Scrollable Content Area -->
		<ScrollViewer Grid.Row="2" Padding="16,0,16,10" VerticalScrollBarVisibility="Auto">
			<StackPanel>

				<!-- Game Running Alert Banner (Phase 4: Safety Lock) -->
				<Border Background="{StaticResource TossRedWeakBrush}" 
						BorderBrush="{StaticResource TossRedBrush}" 
						BorderThickness="1" 
						CornerRadius="10" 
						Padding="14,10" 
						Margin="0,0,0,10"
						Visibility="{Binding IsGameRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Text="⚠️" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
						<StackPanel Grid.Column="1">
							<TextBlock Text="게임 실행 중 · 파일 수정 안전 잠금" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TossRedBrush}" />
							<TextBlock Text="설정 충돌 방지를 위해 수정이 잠깁니다. 게임을 종료하면 자동으로 풀려요." FontSize="12" Foreground="{StaticResource TossGrey700Brush}" TextWrapping="Wrap" />
						</StackPanel>
					</Grid>
				</Border>

				<!-- 공통: 계정 선택 카드 (간결화) -->
				<Border Style="{StaticResource TossCardBorder}">
					<StackPanel>
						<Grid Margin="0,0,0,8">
							<TextBlock Text="기준 게임 계정" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TossGrey900Brush}" />
							<TextBlock Text="{Binding Accounts.Count, StringFormat='총 {0}개 계정 감지'}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TossGrey500Brush}" />
						</Grid>

						<ComboBox ItemsSource="{Binding Accounts}" 
								  SelectedItem="{Binding SelectedAccount}" 
								  DisplayMemberPath="DisplayName"
								  HorizontalAlignment="Stretch" 
								  Height="40"
								  MaxDropDownHeight="250"
								  Margin="0,0,0,10" />

						<!-- 계정 별칭 인라인 편집기 & 옵션 (한 행으로 슬림화) -->
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="6" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="14" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<TextBox Grid.Column="0" 
									 Text="{Binding AccountAliasInput, UpdateSourceTrigger=PropertyChanged}" 
									 Style="{StaticResource TossInputStyle}" 
									 Height="36"
									 HorizontalContentAlignment="Left" />

							<Button Grid.Column="2" 
									Content="별칭 저장" 
									Command="{Binding SaveAccountAliasCommand}" 
									Style="{StaticResource TossSmallButtonStyle}" 
									Height="36" 
									Padding="12,0" />

							<StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
								<TextBlock Text="읽기 전용" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TossGrey700Brush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
								<ui:ToggleSwitch IsChecked="{Binding IsCurrentAccountReadOnly, Mode=TwoWay}" VerticalAlignment="Center" />
							</StackPanel>
						</Grid>
					</StackPanel>
				</Border>

				<!-- ================= TAB 0: 서버 변경 섹션 (1개 통합 카드) ================= -->
				<StackPanel Visibility="{Binding IsServerTab, Converter={StaticResource BooleanToVisibilityConverter}}">
					<Border Style="{StaticResource TossCardBorder}">
						<StackPanel>
							<TextBlock Text="접속할 데이터센터" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TossGrey900Brush}" Margin="0,0,0,2" />
							<TextBlock Text="지연 시간(Ping)을 측정한 뒤 최적의 서버를 선택하세요." FontSize="12" Foreground="{StaticResource TossGrey500Brush}" Margin="0,0,0,12" />

							<!-- 1. 전체 핑 다시 측정하기 버튼 (상단 배치) -->
							<Button Content="전체 핑 다시 측정하기" 
									Command="{Binding TestAllPingCommand}" 
									Style="{StaticResource TossSecondaryButtonStyle}" 
									HorizontalAlignment="Stretch" 
									Margin="0,0,0,10" />

							<!-- 2. 서버 드롭다운 메뉴 (하단 배치) -->
							<ComboBox ItemsSource="{Binding ServerList}" 
									  SelectedItem="{Binding SelectedServer}" 
									  HorizontalAlignment="Stretch" 
									  Height="42"
									  MaxDropDownHeight="280"
									  Margin="0,0,0,10">
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<Grid Margin="4,2">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="Auto" MinWidth="75"/>
											</Grid.ColumnDefinitions>
											<TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TossGrey900Brush}" VerticalAlignment="Center"/>
											<Border Grid.Column="1" Background="{StaticResource TossGrey100Brush}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right">
												<TextBlock Text="{Binding PingText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TossGrey700Brush}" HorizontalAlignment="Center" />
											</Border>
										</Grid>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>

							<!-- 3. 자동 접속 모드 안내 배너 -->
							<Border Background="{StaticResource TossBlueWeakBrush}" 
									CornerRadius="8" 
									Padding="12,8" 
									Visibility="{Binding IsDefaultServerSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
								<TextBlock Text="💡 자동 접속 모드: 게임 켤 때 핑이 가장 낮은 서버에 알아서 연결돼요." 
										   Foreground="{StaticResource TossBlueBrush}" 
										   FontSize="12" 
										   TextWrapping="Wrap" />
							</Border>
						</StackPanel>
					</Border>
				</StackPanel>

				<!-- ================= TAB 1: 감도 · FPS 섹션 (2개 카드로 대폭 통합) ================= -->
				<StackPanel Visibility="{Binding IsMultiplierTab, Converter={StaticResource BooleanToVisibilityConverter}}">

					<!-- 통합 카드 1: 마우스 감도 및 정밀 멀티플라이어 -->
					<Border Style="{StaticResource TossCardBorder}">
						<StackPanel>
							<Grid Margin="0,0,0,8">
								<TextBlock Text="마우스 회전 거리 (cm/360°) &amp; 감도" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TossGrey900Brush}" VerticalAlignment="Center"/>
								<Border Background="{StaticResource TossBlueWeakBrush}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
									<TextBlock Text="{Binding SensitivityFeedbackBadge}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TossBlueBrush}" />
								</Border>
							</Grid>

							<!-- 대형 cm/360° 수치 디스플레이 -->
							<Border Background="{StaticResource TossGrey100Brush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<StackPanel Grid.Column="0">
										<TextBlock Text="{Binding Cm360DisplayText}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TossBlueBrush}" />
										<TextBlock Text="360° 1회전 시 필요한 마우스 이동 거리" FontSize="11" Foreground="{StaticResource TossGrey600Brush}" Margin="0,1,0,0"/>
									</StackPanel>
									<Border Grid.Column="1" VerticalAlignment="Center" Padding="8,5" Background="{StaticResource TossWhiteBrush}" CornerRadius="6">
										<TextBlock Text="{Binding Cm360SubText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TossGrey800Brush}" />
									</Border>
								</Grid>
							</Border>

							<!-- 감도 변환 제안 배너 (조건부 노출) -->
							<Border Background="{StaticResource TossBlueWeakBrush}" BorderBrush="{StaticResource TossBlueBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" Visibility="{Binding HasConversionSuggestion, Converter={StaticResource BooleanToVisibilityConverter}}">
								<StackPanel>
									<TextBlock Text="🔄 멀티플라이어 변경 감지 · 체감 감도 유지 추천" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TossBlueBrush}" Margin="0,0,0,3"/>
									<TextBlock Text="{Binding ConversionSuggestionText}" FontSize="11" Foreground="{StaticResource TossGrey800Brush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="6" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<Button Grid.Column="0" Content="추천 감도 즉시 반영" Command="{Binding ApplySuggestedSensitivityCommand}" Style="{StaticResource TossSmallButtonStyle}" Background="{StaticResource TossBlueBrush}" Foreground="{StaticResource TossWhiteBrush}" Height="30" />
										<Button Grid.Column="2" Content="무시하기" Command="{Binding DismissSuggestedSensitivityCommand}" Style="{StaticResource TossSmallButtonStyle}" Height="30" />
									</Grid>
								</StackPanel>
							</Border>

							<!-- 마우스 DPI 설정 (창 축소 시 잘림 방지: 가로 스택 슬림화) -->
							<Grid Margin="0,0,0,12">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
									<TextBlock Text="마우스 하드웨어 DPI" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TossGrey900Brush}" />
									<TextBlock Text="마우스 소프트웨어 설정값" FontSize="11" Foreground="{StaticResource TossGrey500Brush}" />
								</StackPanel>
								<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
									<Button Content="400" Command="{Binding SetDpiCommand}" CommandParameter="400" Style="{StaticResource TossPillChipStyle}" Height="28"/>
									<Button Content="800" Command="{Binding SetDpiCommand}" CommandParameter="800" Style="{StaticResource TossPillChipStyle}" Height="28"/>
									<Button Content="1600" Command="{Binding SetDpiCommand}" CommandParameter="1600" Style="{StaticResource TossPillChipStyle}" Height="28"/>
									<TextBox Text="{Binding MouseDpi, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TossInputStyle}" Width="60" Height="28" FontSize="11" />
								</StackPanel>
							</Grid>

							<!-- 수평 감도 (Yaw) : ± 버튼 기능 연결 -->
							<Grid Margin="0,0,0,10">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>
								<Grid Grid.Row="0" Margin="0,0,0,2">
									<TextBlock Text="인게임 수평 감도 (Yaw)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TossGrey800Brush}" />
									<TextBlock Text="{Binding CurrentYawSensitivity}" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TossBlueBrush}" />
								</Grid>
								<Grid Grid.Row="1">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<Button Grid.Column="0" Content="−" Command="{Binding StepYawCommand}" CommandParameter="-1" Style="{StaticResource TossCompactStepButtonStyle}" />
									<Slider Grid.Column="1" Minimum="1" Maximum="100" Value="{Binding CurrentYawSensitivity, Mode=TwoWay}" VerticalAlignment="Center" Margin="8,0" />
									<Button Grid.Column="2" Content="+" Command="{Binding StepYawCommand}" CommandParameter="1" Style="{StaticResource TossCompactStepButtonStyle}" />
								</Grid>
							</Grid>

							<!-- 수직 감도 (Pitch) : ± 버튼 기능 연결 -->
							<Grid Margin="0,0,0,12">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>
								<Grid Grid.Row="0" Margin="0,0,0,2">
									<TextBlock Text="인게임 수직 감도 (Pitch)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TossGrey800Brush}" />
									<TextBlock Text="{Binding CurrentPitchSensitivity}" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TossBlueBrush}" />
								</Grid>
								<Grid Grid.Row="1">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<Button Grid.Column="0" Content="−" Command="{Binding StepPitchCommand}" CommandParameter="-1" Style="{StaticResource TossCompactStepButtonStyle}" />
									<Slider Grid.Column="1" Minimum="1" Maximum="100" Value="{Binding CurrentPitchSensitivity, Mode=TwoWay}" VerticalAlignment="Center" Margin="8,0" />
									<Button Grid.Column="2" Content="+" Command="{Binding StepPitchCommand}" CommandParameter="1" Style="{StaticResource TossCompactStepButtonStyle}" />
								</Grid>
							</Grid>

							<!-- 구분선 -->
							<Border Height="1" Background="{StaticResource TossGrey200Brush}" Margin="0,0,0,12" />

							<!-- 마우스 멀티플라이어 및 RawInput (인라인 통합) -->
							<Grid Margin="0,0,0,6">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0">
									<TextBlock Text="감도 멀티플라이어 (Multiplier)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TossGrey800Brush}" />
									<TextBlock Text="{Binding MultiplierHelpText}" FontSize="11" Foreground="{StaticResource TossGrey500Brush}" TextWrapping="Wrap" Margin="0,1,0,0"/>
								</StackPanel>
								<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
									<Button Content="기본값 (0.02)" Command="{Binding SetDefaultMultiplierCommand}" Style="{StaticResource TossPillChipStyle}" Height="28" Margin="0,0,4,0"/>
									<Button Content="정밀 10배 (0.00223)" Command="{Binding SetPrecisionMultiplierCommand}" Style="{StaticResource TossPillChipStyle}" Height="28" Margin="0,0,0,0"/>
								</StackPanel>
							</Grid>

							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="8" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="8" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<TextBox Grid.Column="0" Text="{Binding MouseMultiplierText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TossInputStyle}" Height="34" FontSize="12" />
								<TextBox Grid.Column="2" Text="{Binding XFactorAimingText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TossInputStyle}" Height="34" FontSize="12" />
								<CheckBox Grid.Column="4" IsChecked="{Binding RawInput, Mode=TwoWay}" VerticalAlignment="Center">
									<TextBlock Text="원시 입력" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TossGrey800Brush}" />
								</CheckBox>
							</Grid>
						</StackPanel>
					</Border>

					<!-- 통합 카드 2: 조준기 감도 & FPS 최대 제한 -->
					<Border Style="{StaticResource TossCardBorder}">
						<StackPanel>
							<TextBlock Text="조준기(ADS) 감도 및 FPS 최대 제한" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TossGrey900Brush}" Margin="0,0,0,10" />

							<!-- 1.0x 배율 -->
							<Grid Margin="0,0,0,8">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>
								<Grid Grid.Row="0" Margin="0,0,0,2">
									<TextBlock Text="1.0x 무배율/도트 조준" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TossGrey800Brush}" />
									<TextBlock Text="{Binding AdsScope1x}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TossBlueBrush}" />
								</Grid>
								<Grid Grid.Row="1">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<Button Grid.Column="0" Content="−" Command="{Binding StepAdsScope1xCommand}" CommandParameter="-1" Style="{StaticResource TossCompactStepButtonStyle}" Width="32" Height="32"/>
									<Slider Grid.Column="1" Minimum="1" Maximum="100" Value="{Binding AdsScope1x, Mode=TwoWay}" VerticalAlignment="Center" Margin="8,0" />
									<Button Grid.Column="2" Content="+" Command="{Binding StepAdsScope1xCommand}" CommandParameter="1" Style="{StaticResource TossCompactStepButtonStyle}" Width="32" Height="32"/>
								</Grid>
							</Grid>

							<!-- 2.5x 배율 -->
							<Grid Margin="0,0,0,12">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>
								<Grid Grid.Row="0" Margin="0,0,0,2">
									<TextBlock Text="2.5x 어콕/망원 조준" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TossGrey800Brush}" />
									<TextBlock Text="{Binding AdsScope2x5}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TossBlueBrush}" />
								</Grid>
								<Grid Grid.Row="1">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<Button Grid.Column="0" Content="−" Command="{Binding StepAdsScope2x5Command}" CommandParameter="-1" Style="{StaticResource TossCompactStepButtonStyle}" Width="32" Height="32"/>
									<Slider Grid.Column="1" Minimum="1" Maximum="100" Value="{Binding AdsScope2x5, Mode=TwoWay}" VerticalAlignment="Center" Margin="8,0" />
									<Button Grid.Column="2" Content="+" Command="{Binding StepAdsScope2x5Command}" CommandParameter="1" Style="{StaticResource TossCompactStepButtonStyle}" Width="32" Height="32"/>
								</Grid>
							</Grid>

							<!-- 구분선 -->
							<Border Height="1" Background="{StaticResource TossGrey200Brush}" Margin="0,0,0,12" />

							<!-- FPS 최대 제한 -->
							<Grid Margin="0,0,0,4">
								<TextBlock Text="FPS 최대 제한 (FPSLimit)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TossGrey800Brush}" />
								<TextBlock Text="{Binding FpsLimitDisplayText}" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TossBlueBrush}" />
							</Grid>

							<Slider Minimum="0" Maximum="360" Value="{Binding CurrentFpsLimit, Mode=TwoWay}" Margin="0,0,0,8" />

							<WrapPanel>
								<Button Content="제한 없음 (0)" Command="{Binding SetFpsLimitPresetCommand}" CommandParameter="0" Style="{StaticResource TossPillChipStyle}" Height="28"/>
								<Button Content="141 FPS (144Hz)" Command="{Binding SetFpsLimitPresetCommand}" CommandParameter="141" Style="{StaticResource TossPillChipStyle}" Height="28"/>
								<Button Content="162 FPS (165Hz)" Command="{Binding SetFpsLimitPresetCommand}" CommandParameter="162" Style="{StaticResource TossPillChipStyle}" Height="28"/>
								<Button Content="237 FPS (240Hz)" Command="{Binding SetFpsLimitPresetCommand}" CommandParameter="237" Style="{StaticResource TossPillChipStyle}" Height="28"/>
								<Button Content="357 FPS (360Hz)" Command="{Binding SetFpsLimitPresetCommand}" CommandParameter="357" Style="{StaticResource TossPillChipStyle}" Height="28"/>
							</WrapPanel>
						</StackPanel>
					</Border>

				</StackPanel>

				<!-- ================= TAB 2: 동기화 · 백업 섹션 (2개 카드로 통합) ================= -->
				<StackPanel Visibility="{Binding IsBackupTab, Converter={StaticResource BooleanToVisibilityConverter}}">

					<!-- 카드 1: 다계정 설정 일괄 동기화 -->
					<Border Style="{StaticResource TossCardBorder}">
						<StackPanel>
							<TextBlock Text="다계정 설정 일괄 동기화" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TossGrey900Brush}" Margin="0,0,0,2" />
							<TextBlock Text="기준 계정의 설정을 다른 부계정에 똑같이 복사해요." FontSize="12" Foreground="{StaticResource TossGrey500Brush}" Margin="0,0,0,10" />

							<!-- 동기화 카테고리 체크박스 그리드 -->
							<Border Background="{StaticResource TossGrey100Brush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="Auto"/>
									</Grid.RowDefinitions>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>

									<CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding SyncInput, Mode=TwoWay}" Margin="0,2">
										<TextBlock Text="마우스/감도" FontSize="12" Foreground="{StaticResource TossGrey800Brush}"/>
									</CheckBox>
									<CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding SyncColors, Mode=TwoWay}" Margin="0,2">
										<TextBlock Text="조준선 색상" FontSize="12" Foreground="{StaticResource TossGrey800Brush}"/>
									</CheckBox>
									<CheckBox Grid.Row="0" Grid.Column="2" IsChecked="{Binding SyncDisplay, Mode=TwoWay}" Margin="0,2">
										<TextBlock Text="디스플레이" FontSize="12" Foreground="{StaticResource TossGrey800Brush}"/>
									</CheckBox>
									<CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding SyncAudio, Mode=TwoWay}" Margin="0,2">
										<TextBlock Text="오디오" FontSize="12" Foreground="{StaticResource TossGrey800Brush}"/>
									</CheckBox>
									<CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding SyncGameplay, Mode=TwoWay}" Margin="0,2">
										<TextBlock Text="게임플레이" FontSize="12" Foreground="{StaticResource TossGrey800Brush}"/>
									</CheckBox>
									<CheckBox Grid.Row="1" Grid.Column="2" IsChecked="{Binding SyncQuality, Mode=TwoWay}" Margin="0,2">
										<TextBlock Text="그래픽 품질" FontSize="12" Foreground="{StaticResource TossGrey800Brush}"/>
									</CheckBox>
								</Grid>
							</Border>

							<!-- 보조 계정 선택 안내 또는 체크박스 목록 -->
							<TextBlock Text="동기화를 적용할 보조 계정 선택:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TossGrey800Brush}" Margin="0,0,0,6" />

							<!-- 보조 계정이 없을 때 안내 메시지 -->
							<Border Background="{StaticResource TossGrey100Brush}" 
									CornerRadius="8" 
									Padding="14,10" 
									Margin="0,0,0,10"
									Visibility="{Binding HasNoSyncTargets, Converter={StaticResource BooleanToVisibilityConverter}}">
								<TextBlock Text="💡 동기화할 수 있는 다른 보조 계정이 감지되지 않았어요. (현재 1개의 계정만 등록되어 있습니다)" 
										   FontSize="12" 
										   Foreground="{StaticResource TossGrey600Brush}" 
										   TextWrapping="Wrap" />
							</Border>

							<!-- 보조 계정 목록이 있을 때 노출 -->
							<ItemsControl ItemsSource="{Binding SyncTargetAccounts}" 
										  Margin="0,0,0,10"
										  Visibility="{Binding HasSyncTargets, Converter={StaticResource BooleanToVisibilityConverter}}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<CheckBox IsChecked="{Binding IsSyncTarget, Mode=TwoWay}" Margin="0,2,0,4">
											<TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="{StaticResource TossGrey800Brush}"/>
										</CheckBox>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<Button Content="선택한 계정들로 설정 동기화하기" 
									Command="{Binding SyncSelectedAccountsCommand}" 
									IsEnabled="{Binding CanModifySettings}"
									Style="{StaticResource TossSecondaryButtonStyle}" 
									Height="38" 
									HorizontalAlignment="Stretch" />
						</StackPanel>
					</Border>

					<!-- 카드 2: 설정 프리셋 백업 & 복원 (2x2 그리드로 버튼 텍스트 잘림 방지) -->
					<Border Style="{StaticResource TossCardBorder}">
						<StackPanel>
							<Grid Margin="0,0,0,2">
								<TextBlock Text="설정 프리셋 백업 및 복원" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TossGrey900Brush}" />
								<TextBlock Text="{Binding Presets.Count, StringFormat='저장된 프리셋 {0}개'}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TossGrey500Brush}" />
							</Grid>
							<TextBlock Text="현재 최적화된 설정을 이름 붙여 보관하고 언제든 되돌려요." FontSize="12" Foreground="{StaticResource TossGrey500Brush}" Margin="0,0,0,10" />

							<!-- 프리셋 신규 생성 -->
							<Grid Margin="0,0,0,10">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="6" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<TextBox Grid.Column="0" Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TossInputStyle}" Height="36" FontSize="12" HorizontalContentAlignment="Left" />
								<Button Grid.Column="2" Content="현재 설정 저장" Command="{Binding SavePresetCommand}" Style="{StaticResource TossSmallButtonStyle}" Height="36" Padding="12,0" />
							</Grid>

							<!-- 프리셋 목록 & 조작 버튼 -->
							<ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" Height="38" Margin="0,0,0,8" />

							<!-- 2x2 버튼 그리드로 창 축소 시에도 텍스트 잘림 원천 방지 -->
							<Grid Margin="0,0,0,6">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="6" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>

								<Button Grid.Row="0" Grid.Column="0" Content="설정 복원" Command="{Binding RestorePresetCommand}" IsEnabled="{Binding CanModifySettings}" Style="{StaticResource TossSecondaryButtonStyle}" Height="36" Margin="0,0,0,6" />
								<Button Grid.Row="0" Grid.Column="2" Content="차이 비교" Command="{Binding ComparePresetCommand}" Style="{StaticResource TossSmallButtonStyle}" Height="36" Margin="0,0,0,6" />
								<Button Grid.Row="1" Grid.Column="0" Content="외부 내보내기" Command="{Binding ExportPresetCommand}" Style="{StaticResource TossSmallButtonStyle}" Height="36" />
								<Button Grid.Row="1" Grid.Column="2" Content="프리셋 삭제" Command="{Binding DeletePresetCommand}" Style="{StaticResource TossSmallButtonStyle}" Height="36" />
							</Grid>

							<Button Content="외부 프리셋 파일(.json / .ini) 불러오기" Command="{Binding ImportPresetCommand}" Style="{StaticResource TossSmallButtonStyle}" HorizontalAlignment="Stretch" Height="32" FontSize="12" />

							<!-- 프리셋 변경점 Diff (비교 시에만 노출) -->
							<Border Background="{StaticResource TossGrey100Brush}" CornerRadius="8" Padding="10" Margin="0,10,0,0" MaxHeight="150" Visibility="{Binding HasDiffItems, Converter={StaticResource BooleanToVisibilityConverter}}">
								<ScrollViewer VerticalScrollBarVisibility="Auto">
									<ItemsControl ItemsSource="{Binding DiffItems}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Border Background="{StaticResource TossWhiteBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,0,4">
													<Grid>
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="Auto" />
															<ColumnDefinition Width="*" />
														</Grid.ColumnDefinitions>
														<Border Grid.Column="0" Background="{StaticResource TossBlueWeakBrush}" CornerRadius="4" Padding="4,1" Margin="0,0,6,0">
															<TextBlock Text="{Binding Section}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TossBlueBrush}" />
														</Border>
														<TextBlock Grid.Column="1" Text="{Binding DisplayDiff}" FontSize="11" Foreground="{StaticResource TossGrey900Brush}" VerticalAlignment="Center" />
													</Grid>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</ScrollViewer>
							</Border>
						</StackPanel>
					</Border>

				</StackPanel>

				<!-- ================= TAB 3: 리플레이 보관소 섹션 ================= -->
				<StackPanel Visibility="{Binding IsReplayTab, Converter={StaticResource BooleanToVisibilityConverter}}">

					<!-- 컴팩트 리플레이 안내 가이드 -->
					<Border Background="{StaticResource TossBlueWeakBrush}" BorderBrush="{StaticResource TossBlueBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
						<StackPanel>
							<Grid Margin="0,0,0,4">
								<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
									<TextBlock Text="🎬" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
									<TextBlock Text="매치 리플레이 영구 보관이 왜 필요한가요?" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TossBlueBrush}" VerticalAlignment="Center" />
								</StackPanel>
								<Border Background="{StaticResource TossWhiteBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
									<TextBlock Text="안심 보관" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TossBlueBrush}" />
								</Border>
							</Grid>
							<TextBlock Text="시즈는 최근 12경기만 임시 저장하며, 새 경기를 치르거나 시즌 대규모 패치 시 이전 리플레이가 자동 삭제됩니다. 명장면을 영구 보관소로 백업해두면 삭제 걱정 없이 언제든 다시 볼 수 있어요." 
									   FontSize="12" Foreground="{StaticResource TossGrey800Brush}" TextWrapping="Wrap" LineHeight="17" />
						</StackPanel>
					</Border>

					<!-- 리플레이 조작 카드 -->
					<Border Style="{StaticResource TossCardBorder}">
						<StackPanel>
							<TextBlock Text="매치 리플레이 영구 보관소" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TossGrey900Brush}" Margin="0,0,0,2" />
							<TextBlock Text="인게임 최근 경기 리플레이를 영구 보관소로 복사하거나 게임으로 되돌려요." FontSize="12" Foreground="{StaticResource TossGrey500Brush}" Margin="0,0,0,10" />

							<!-- 경로 및 탐색기 바로가기 -->
							<Grid Margin="0,0,0,10">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="6" />
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="6" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<TextBox Grid.Column="0" Text="{Binding MatchReplayPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TossInputStyle}" Height="34" FontSize="11" HorizontalContentAlignment="Left" />
								<Button Grid.Column="2" Content="인게임 폴더" Command="{Binding OpenMatchReplayFolderCommand}" Style="{StaticResource TossSmallButtonStyle}" Height="34" />
								<Button Grid.Column="4" Content="영구 보관함" Command="{Binding OpenArchiveFolderCommand}" Style="{StaticResource TossSmallButtonStyle}" Height="34" />
							</Grid>

							<!-- 1. 게임 내 활성 리플레이 목록 & 백업 -->
							<TextBlock Text="인게임 저장된 최근 경기:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TossGrey800Brush}" Margin="0,0,0,4" />
							<ComboBox ItemsSource="{Binding ActiveReplays}" SelectedItem="{Binding SelectedActiveReplay}" DisplayMemberPath="DisplayTitle" HorizontalAlignment="Stretch" Height="38" Margin="0,0,0,6" />
							<Button Content="선택 리플레이 영구 보관소로 백업" Command="{Binding BackupSelectedReplayCommand}" Style="{StaticResource TossSecondaryButtonStyle}" Height="38" Margin="0,0,0,12" HorizontalAlignment="Stretch" />

							<!-- 구분선 -->
							<Border Height="1" Background="{StaticResource TossGrey200Brush}" Margin="0,0,0,12" />

							<!-- 2. 영구 보관소 리플레이 목록 & 복원/삭제 -->
							<TextBlock Text="영구 보관소에 저장된 리플레이:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TossGrey800Brush}" Margin="0,0,0,4" />
							<ComboBox ItemsSource="{Binding ArchivedReplays}" SelectedItem="{Binding SelectedArchivedReplay}" DisplayMemberPath="DisplayTitle" HorizontalAlignment="Stretch" Height="38" Margin="0,0,0,6" />

							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="6" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<Button Grid.Column="0" Content="선택 리플레이 게임으로 복원" Command="{Binding RestoreSelectedReplayCommand}" Style="{StaticResource TossSecondaryButtonStyle}" Height="38" />
								<Button Grid.Column="2" Content="보관함에서 삭제" Command="{Binding DeleteSelectedArchivedReplayCommand}" Style="{StaticResource TossSmallButtonStyle}" Height="38" Padding="14,0" />
							</Grid>
						</StackPanel>
					</Border>

				</StackPanel>

				<!-- ================= TAB 4: 캐시 정리 섹션 (단 1개 통합 카드) ================= -->
				<StackPanel Visibility="{Binding IsCacheTab, Converter={StaticResource BooleanToVisibilityConverter}}">

					<Border Style="{StaticResource TossCardBorder}">
						<StackPanel>
							<!-- 상단 헤더 & 아웃라인 재스캔 버튼 -->
							<Grid Margin="0,0,0,6">
								<StackPanel VerticalAlignment="Center">
									<TextBlock Text="DirectX 셰이더 및 런처 캐시 정리" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TossGrey900Brush}" />
									<TextBlock Text="스터터링(프레임 드랍) 및 클라우드 동기화 오류를 해결해요." FontSize="12" Foreground="{StaticResource TossGrey500Brush}" Margin="0,1,0,0"/>
								</StackPanel>

								<Button Content="🔄 캐시 다시 스캔" 
										Command="{Binding ScanAllCachesCommand}" 
										Style="{StaticResource TossOutlineButtonStyle}" 
										HorizontalAlignment="Right" 
										Height="34" />
							</Grid>

							<!-- 발견된 캐시 용량 요약 배너 -->
							<Border Background="{StaticResource TossGrey100Brush}" CornerRadius="8" Padding="12,8" Margin="0,6,0,10">
								<Grid>
									<TextBlock Text="정리 가능한 캐시 파일 목록" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TossGrey700Brush}" VerticalAlignment="Center"/>
									<TextBlock Text="{Binding TotalScannedCacheFormatted, StringFormat='발견된 용량: {0}'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TossBlueBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
								</Grid>
							</Border>

							<!-- 캐시 대상 목록 (컴팩트 카드) -->
							<Border Background="{StaticResource TossGrey100Brush}" CornerRadius="8" Padding="8" Margin="0,0,0,12">
								<ItemsControl ItemsSource="{Binding CacheTargets}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border Background="{StaticResource TossWhiteBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,4" BorderBrush="{StaticResource TossGrey200Brush}" BorderThickness="1">
												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*" />
														<ColumnDefinition Width="Auto" />
													</Grid.ColumnDefinitions>
													<StackPanel Grid.Column="0">
														<CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,0,1">
															<TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TossGrey900Brush}" />
														</CheckBox>
														<TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TossGrey600Brush}" Margin="22,0,0,0" TextWrapping="Wrap" />
													</StackPanel>
													<Border Grid.Column="1" Background="{StaticResource TossBlueWeakBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
														<TextBlock Text="{Binding FormattedSize}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TossBlueBrush}" />
													</Border>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</Border>

							<!-- 명확한 삭제 액션 버튼 -->
							<Button Content="{Binding CleanCacheButtonText}" 
									Command="{Binding CleanSelectedCachesCommand}" 
									IsEnabled="{Binding CanModifySettings}"
									Style="{StaticResource TossPrimaryButtonStyle}" 
									Height="46" 
									HorizontalAlignment="Stretch" />
						</StackPanel>
					</Border>

				</StackPanel>

			</StackPanel>
		</ScrollViewer>

		<!-- 4. Fixed Bottom CTA & Status Area -->
		<Border Grid.Row="3" 
				Background="{StaticResource TossWhiteBrush}" 
				BorderBrush="{StaticResource TossGrey200Brush}" 
				BorderThickness="0,1,0,0" 
				Padding="16,10,16,14">
			<StackPanel>
				<TextBlock Text="{Binding StatusMessage}" 
						   FontSize="12" 
						   Foreground="{StaticResource TossGrey600Brush}" 
						   HorizontalAlignment="Center" 
						   Margin="0,0,0,6" />

				<Button Content="{Binding PrimaryCtaText}" 
						Command="{Binding ExecutePrimaryActionCommand}" 
						IsEnabled="{Binding CanModifySettings}"
						Style="{StaticResource TossPrimaryButtonStyle}" 
						HorizontalAlignment="Stretch" 
						Margin="0,0,0,8" />

				<!-- Quick Game Launchers (Phase 4) -->
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="8" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<Button Grid.Column="0" 
							Command="{Binding LaunchSteamGameCommand}" 
							Style="{StaticResource TossSecondaryButtonStyle}" 
							Height="38">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="🎮" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
							<TextBlock Text="Steam으로 실행" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
						</StackPanel>
					</Button>

					<Button Grid.Column="2" 
							Command="{Binding LaunchUbisoftGameCommand}" 
							Style="{StaticResource TossSecondaryButtonStyle}" 
							Height="38">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="⚡" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
							<TextBlock Text="Ubisoft로 실행" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
						</StackPanel>
					</Button>
				</Grid>
			</StackPanel>
		</Border>

	</Grid>
</ui:FluentWindow>
