<ui:FluentWindow x:Class="R6Tools.Views.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
		xmlns:viewmodels="clr-namespace:R6Tools.ViewModels"
		mc:Ignorable="d"
		Title="Rainbow Six Siege Tools" 
		Height="860" Width="580"
		MinHeight="700" MinWidth="540"
		WindowStartupLocation="CenterScreen"
		ExtendsContentIntoTitleBar="True"
		WindowBackdropType="None"
		Background="{DynamicResource TossGrey50Brush}"
		FontFamily="{StaticResource TossFontFamily}">

	<Window.DataContext>
		<viewmodels:MainViewModel />
	</Window.DataContext>

	<Window.Resources>
		<BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

		<!-- 토스 미니멀 카드 스타일 (다크/라이트 동적 전환 지원) -->
		<Style x:Key="TossCardBorder" TargetType="Border">
			<Setter Property="Background" Value="{DynamicResource TossWhiteBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource TossGrey200Brush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="14" />
			<Setter Property="Padding" Value="18" />
			<Setter Property="Margin" Value="0,0,0,12" />
		</Style>

		<!-- 토스 세그먼트 탭 라디오 버튼 스타일 (동적 테마 및 다국어 지원) -->
		<Style x:Key="TossSegmentedTabStyle" TargetType="RadioButton">
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="VerticalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Foreground" Value="{DynamicResource TossGrey600Brush}" />
			<Setter Property="FontSize" Value="12.5" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="RadioButton">
						<Border x:Name="tabBorder"
								Background="Transparent"
								CornerRadius="8"
								HorizontalAlignment="Stretch"
								VerticalAlignment="Stretch"
								Padding="2,0"
								Margin="1">
							<ContentPresenter HorizontalAlignment="Center" 
											  VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource TossWhiteBrush}" />
								<Setter TargetName="tabBorder" Property="BorderBrush" Value="{DynamicResource TossGrey200Brush}" />
								<Setter TargetName="tabBorder" Property="BorderThickness" Value="1" />
								<Setter TargetName="tabBorder" Property="Effect">
									<Setter.Value>
										<DropShadowEffect BlurRadius="5" ShadowDepth="1.5" Direction="270" Color="#191F28" Opacity="0.12" />
									</Setter.Value>
								</Setter>
								<Setter Property="Foreground" Value="{DynamicResource TossBlueBrush}" />
								<Setter Property="FontWeight" Value="Bold" />
							</Trigger>
							<MultiTrigger>
								<MultiTrigger.Conditions>
									<Condition Property="IsMouseOver" Value="True" />
									<Condition Property="IsChecked" Value="False" />
								</MultiTrigger.Conditions>
								<Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource TossGrey100Brush}" />
								<Setter Property="Foreground" Value="{DynamicResource TossGrey900Brush}" />
							</MultiTrigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- 토스 프라이머리 CTA 버튼 스타일 -->
		<Style x:Key="TossPrimaryButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="{DynamicResource TossBlueBrush}" />
			<Setter Property="Foreground" Value="#FFFFFF" />
			<Setter Property="FontSize" Value="15" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Height" Value="50" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border"
								Background="{TemplateBinding Background}"
								CornerRadius="14"
								SnapsToDevicePixels="True">
							<ContentPresenter HorizontalAlignment="Center" 
											  VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Background" Value="{DynamicResource TossBluePressedBrush}" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="border" Property="Background" Value="{DynamicResource TossBluePressedBrush}" />
								<Setter TargetName="border" Property="Opacity" Value="0.88" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="border" Property="Opacity" Value="0.30" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- 토스 세컨더리 버튼 스타일 -->
		<Style x:Key="TossSecondaryButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="{DynamicResource TossGrey100Brush}" />
			<Setter Property="Foreground" Value="{DynamicResource TossGrey800Brush}" />
			<Setter Property="FontSize" Value="14" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Height" Value="42" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border"
								Background="{TemplateBinding Background}"
								CornerRadius="10"
								SnapsToDevicePixels="True">
							<ContentPresenter HorizontalAlignment="Center" 
											  VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Background" Value="{DynamicResource TossGrey200Brush}" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="border" Property="Opacity" Value="0.8" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="border" Property="Opacity" Value="0.35" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- 토스 스몰 액션 버튼 스타일 -->
		<Style x:Key="TossSmallButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="{DynamicResource TossGrey100Brush}" />
			<Setter Property="Foreground" Value="{DynamicResource TossGrey800Brush}" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Height" Value="36" />
			<Setter Property="Padding" Value="12,0" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border"
								Background="{TemplateBinding Background}"
								CornerRadius="8"
								Padding="{TemplateBinding Padding}"
								SnapsToDevicePixels="True">
							<ContentPresenter HorizontalAlignment="Center" 
											  VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Background" Value="{DynamicResource TossGrey200Brush}" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="border" Property="Opacity" Value="0.8" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="border" Property="Opacity" Value="0.35" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- 토스 아웃라인 버튼 스타일 -->
		<Style x:Key="TossOutlineButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="{DynamicResource TossWhiteBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource TossBlueBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource TossBlueBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Height" Value="36" />
			<Setter Property="Padding" Value="14,0" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="8"
								Padding="{TemplateBinding Padding}"
								SnapsToDevicePixels="True">
							<ContentPresenter HorizontalAlignment="Center" 
											  VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Background" Value="{DynamicResource TossBlueWeakBrush}" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="border" Property="Opacity" Value="0.8" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="border" Property="Opacity" Value="0.35" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- 토스 칩/태그 버튼 스타일 -->
		<Style x:Key="TossPillChipStyle" TargetType="Button">
			<Setter Property="Background" Value="{DynamicResource TossGrey100Brush}" />
			<Setter Property="Foreground" Value="{DynamicResource TossGrey700Brush}" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Height" Value="30" />
			<Setter Property="Padding" Value="10,0" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Margin" Value="0,0,4,4" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border"
								Background="{TemplateBinding Background}"
								CornerRadius="8"
								Padding="{TemplateBinding Padding}"
								SnapsToDevicePixels="True">
							<ContentPresenter HorizontalAlignment="Center" 
											  VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Background" Value="{DynamicResource TossBlueWeakBrush}" />
								<Setter Property="Foreground" Value="{DynamicResource TossBlueBrush}" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="border" Property="Opacity" Value="0.8" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="border" Property="Opacity" Value="0.35" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- 토스 스텝 컴팩트 버튼 (+, - : 8px radius) -->
		<Style x:Key="TossCompactStepButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="{DynamicResource TossGrey100Brush}" />
			<Setter Property="Foreground" Value="{DynamicResource TossBlueBrush}" />
			<Setter Property="FontSize" Value="14" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Width" Value="34" />
			<Setter Property="Height" Value="34" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border"
								Background="{TemplateBinding Background}"
								CornerRadius="8"
								SnapsToDevicePixels="True">
							<ContentPresenter HorizontalAlignment="Center" 
											  VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Background" Value="{DynamicResource TossBlueWeakBrush}" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="border" Property="Opacity" Value="0.75" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="border" Property="Opacity" Value="0.35" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- 토스 텍스트 입력창 스타일 -->
		<Style x:Key="TossInputStyle" TargetType="TextBox">
			<Setter Property="Background" Value="{DynamicResource TossGrey100Brush}" />
			<Setter Property="Foreground" Value="{DynamicResource TossGrey900Brush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource TossGrey200Brush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Height" Value="38" />
			<Setter Property="Padding" Value="10,0" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border x:Name="border"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="10"
								SnapsToDevicePixels="True">
							<ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsFocused" Value="True">
								<Setter TargetName="border" Property="Background" Value="{DynamicResource TossWhiteBrush}" />
								<Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource TossBlueBrush}" />
								<Setter TargetName="border" Property="BorderThickness" Value="1.5" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- 1. Window TitleBar (다국어/테마/새로고침 컨트롤 추가) -->
		<ui:TitleBar Title="R6 Tools" Grid.Row="0">
			<ui:TitleBar.Header>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<!-- 상단 우측: 언어 전환, 다크모드 토글, 새로고침 버튼 -->
					<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
						<!-- 언어 전환 버튼 (KO / EN) -->
						<Button Command="{Binding ToggleLanguageCommand}" 
								Content="{Binding LanguageButtonText}" 
								Style="{StaticResource TossSmallButtonStyle}" 
								Height="30" 
								Padding="10,0"
								Margin="0,0,6,0"
								ToolTip="Switch Language (한국어 / English)" />

						<!-- 다크모드 토글 버튼 (🌙 / ☀️) -->
						<Button Command="{Binding ToggleThemeCommand}" 
								Content="{Binding ThemeButtonText}" 
								Style="{StaticResource TossSmallButtonStyle}" 
								Height="30" 
								Padding="10,0"
								Margin="0,0,6,0"
								ToolTip="Toggle Dark Mode" />

						<!-- 새로고침 버튼 -->
						<Button Command="{Binding RefreshDataCommand}" 
								Content="{DynamicResource Str_Refresh}" 
								Style="{StaticResource TossSmallButtonStyle}" 
								Height="30" 
								Padding="12,0" />
					</StackPanel>
				</Grid>
			</ui:TitleBar.Header>
		</ui:TitleBar>

		<!-- 2. Header & TDS Segmented Control (5-Tab Switcher) -->
		<StackPanel Grid.Row="1" Margin="16,6,16,10">
			<!-- Hero Title -->
			<TextBlock Text="{DynamicResource Str_HeroTitle}" 
					   FontSize="18" 
					   FontWeight="Bold" 
					   Foreground="{DynamicResource TossGrey900Brush}" 
					   Margin="0,0,0,2" />
			<TextBlock Text="{DynamicResource Str_HeroSubtitle}" 
					   FontSize="12" 
					   Foreground="{DynamicResource TossGrey600Brush}" 
					   Margin="0,0,0,8" />

			<!-- TDS Segmented Control -->
			<Border Background="{DynamicResource TossGrey100Brush}" 
					CornerRadius="10" 
					Padding="3" 
					Height="44">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<!-- Tab 0: 서버 -->
					<RadioButton Grid.Column="0" 
								 GroupName="TdsTabs"
								 Content="{DynamicResource Str_TabServer}"
								 IsChecked="{Binding IsServerTab, Mode=TwoWay}"
								 Command="{Binding SelectTabCommand}" 
								 CommandParameter="0"
								 Style="{StaticResource TossSegmentedTabStyle}" />

					<!-- Tab 1: 감도 · FPS -->
					<RadioButton Grid.Column="1" 
								 GroupName="TdsTabs"
								 Content="{DynamicResource Str_TabSens}"
								 IsChecked="{Binding IsMultiplierTab, Mode=TwoWay}"
								 Command="{Binding SelectTabCommand}" 
								 CommandParameter="1"
								 Style="{StaticResource TossSegmentedTabStyle}" />

					<!-- Tab 2: 동기화 -->
					<RadioButton Grid.Column="2" 
								 GroupName="TdsTabs"
								 Content="{DynamicResource Str_TabSync}"
								 IsChecked="{Binding IsBackupTab, Mode=TwoWay}"
								 Command="{Binding SelectTabCommand}" 
								 CommandParameter="2"
								 Style="{StaticResource TossSegmentedTabStyle}" />

					<!-- Tab 3: 리플레이 -->
					<RadioButton Grid.Column="3" 
								 GroupName="TdsTabs"
								 Content="{DynamicResource Str_TabReplay}"
								 IsChecked="{Binding IsReplayTab, Mode=TwoWay}"
								 Command="{Binding SelectTabCommand}" 
								 CommandParameter="3"
								 Style="{StaticResource TossSegmentedTabStyle}" />

					<!-- Tab 4: 캐시 정리 -->
					<RadioButton Grid.Column="4" 
								 GroupName="TdsTabs"
								 Content="{DynamicResource Str_TabCache}"
								 IsChecked="{Binding IsCacheTab, Mode=TwoWay}"
								 Command="{Binding SelectTabCommand}" 
								 CommandParameter="4"
								 Style="{StaticResource TossSegmentedTabStyle}" />
				</Grid>
			</Border>
		</StackPanel>

		<!-- 3. Scrollable Content Area -->
		<ScrollViewer Grid.Row="2" Padding="16,0,16,10" VerticalScrollBarVisibility="Auto">
			<StackPanel>

				<!-- Game Running Alert Banner (Phase 4: Safety Lock) -->
				<Border Background="{DynamicResource TossRedWeakBrush}" 
						BorderBrush="{DynamicResource TossRedBrush}" 
						BorderThickness="1" 
						CornerRadius="10" 
						Padding="14,10" 
						Margin="0,0,0,10"
						Visibility="{Binding IsGameRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Text="⚠️" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
						<StackPanel Grid.Column="1">
							<TextBlock Text="{DynamicResource Str_GameRunningBannerTitle}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TossRedBrush}" />
							<TextBlock Text="{DynamicResource Str_GameRunningBannerDesc}" FontSize="12" Foreground="{DynamicResource TossGrey700Brush}" TextWrapping="Wrap" />
						</StackPanel>
					</Grid>
				</Border>

				<!-- 공통: 계정 선택 카드 (요구사항 1: 별칭 수정은 필요할 때만 토글로 노출) -->
				<Border Style="{StaticResource TossCardBorder}">
					<StackPanel>
						<Grid Margin="0,0,0,8">
							<TextBlock Text="{DynamicResource Str_ActiveAccount}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TossGrey900Brush}" />
							<TextBlock Text="{Binding Accounts.Count, StringFormat={}{0} Accounts}" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource TossGrey500Brush}" />
						</Grid>

						<!-- Row 1: 계정 드롭다운 + ✏️ 별칭 수정 토글 버튼 + 읽기 전용 토글 -->
						<Grid Margin="0,0,0,4">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="6" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="14" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<ComboBox Grid.Column="0" 
									  ItemsSource="{Binding Accounts}" 
									  SelectedItem="{Binding SelectedAccount}" 
									  DisplayMemberPath="DisplayName"
									  HorizontalAlignment="Stretch" 
									  Height="38"
									  MaxDropDownHeight="250" />

							<!-- ✏️ 필요할 때만 별칭을 수정하는 토글 버튼 (요구사항 1) -->
							<Button Grid.Column="2" 
									Command="{Binding ToggleEditAliasCommand}" 
									Style="{StaticResource TossSmallButtonStyle}" 
									Height="38" 
									Padding="10,0"
									ToolTip="Edit Account Alias">
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="✏️" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
									<TextBlock Text="{DynamicResource Str_EditAlias}" FontSize="12" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>

							<StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
								<TextBlock Text="{DynamicResource Str_ReadOnly}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TossGrey700Brush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
								<ui:ToggleSwitch IsChecked="{Binding IsCurrentAccountReadOnly, Mode=TwoWay}" VerticalAlignment="Center" />
							</StackPanel>
						</Grid>

						<!-- Row 2: 별칭 인라인 편집기 (IsEditingAlias == true 일 때만 펼쳐짐) -->
						<Border Background="{DynamicResource TossGrey100Brush}" 
								CornerRadius="8" 
								Padding="10,8" 
								Margin="0,8,0,0"
								Visibility="{Binding IsEditingAlias, Converter={StaticResource BooleanToVisibilityConverter}}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="6" />
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="6" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>

								<TextBox Grid.Column="0" 
										 Text="{Binding AccountAliasInput, UpdateSourceTrigger=PropertyChanged}" 
										 Style="{StaticResource TossInputStyle}" 
										 Height="34" 
										 HorizontalContentAlignment="Left" />

								<Button Grid.Column="2" 
										Content="{DynamicResource Str_SaveAlias}" 
										Command="{Binding SaveAccountAliasCommand}" 
										Style="{StaticResource TossSmallButtonStyle}" 
										Background="{DynamicResource TossBlueBrush}" 
										Foreground="#FFFFFF" 
										Height="34" 
										Padding="12,0" />

								<Button Grid.Column="4" 
										Content="{DynamicResource Str_Close}" 
										Command="{Binding CancelEditAliasCommand}" 
										Style="{StaticResource TossSmallButtonStyle}" 
										Height="34" 
										Padding="10,0" />
							</Grid>
						</Border>
					</StackPanel>
				</Border>

				<!-- ================= TAB 0: 서버 변경 섹션 (1개 통합 카드) ================= -->
				<StackPanel Visibility="{Binding IsServerTab, Converter={StaticResource BooleanToVisibilityConverter}}">
					<Border Style="{StaticResource TossCardBorder}">
						<StackPanel>
							<TextBlock Text="{DynamicResource Str_ServerCardTitle}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TossGrey900Brush}" Margin="0,0,0,2" />
							<TextBlock Text="{DynamicResource Str_ServerCardDesc}" FontSize="12" Foreground="{DynamicResource TossGrey500Brush}" Margin="0,0,0,12" />

							<!-- 1. 전체 핑 다시 측정하기 버튼 (상단 배치) -->
							<Button Content="{DynamicResource Str_TestAllPing}" 
									Command="{Binding TestAllPingCommand}" 
									Style="{StaticResource TossSecondaryButtonStyle}" 
									HorizontalAlignment="Stretch" 
									Margin="0,0,0,10" />

							<!-- 2. 서버 드롭다운 메뉴 (하단 배치) -->
							<ComboBox ItemsSource="{Binding ServerList}" 
									  SelectedItem="{Binding SelectedServer}" 
									  HorizontalAlignment="Stretch" 
									  Height="42"
									  MaxDropDownHeight="280"
									  Margin="0,0,0,10">
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<Grid Margin="4,2">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="Auto" MinWidth="75"/>
											</Grid.ColumnDefinitions>
											<TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TossGrey900Brush}" VerticalAlignment="Center"/>
											<Border Grid.Column="1" Background="{DynamicResource TossGrey100Brush}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right">
												<TextBlock Text="{Binding PingText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TossGrey700Brush}" HorizontalAlignment="Center" />
											</Border>
										</Grid>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>

							<!-- 3. 자동 접속 모드 안내 배너 -->
							<Border Background="{DynamicResource TossBlueWeakBrush}" 
									CornerRadius="8" 
									Padding="12,8" 
									Visibility="{Binding IsDefaultServerSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
								<TextBlock Text="{DynamicResource Str_AutoConnectNotice}" 
										   Foreground="{DynamicResource TossBlueBrush}" 
										   FontSize="12" 
										   TextWrapping="Wrap" />
							</Border>
						</StackPanel>
					</Border>
				</StackPanel>

				<!-- ================= TAB 1: 멀티플라이어 섹션 ================= -->
				<StackPanel Visibility="{Binding IsMultiplierTab, Converter={StaticResource BooleanToVisibilityConverter}}">

					<!-- 단일 통합 카드: 마우스 및 조준 감도 멀티플라이어 -->
					<Border Style="{StaticResource TossCardBorder}">
						<StackPanel>
							<!-- 카드 헤더 -->
							<TextBlock Text="{DynamicResource Str_SensCard1Title}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TossGrey900Brush}" Margin="0,0,0,2" />
							<TextBlock Text="{DynamicResource Str_SensCard1Desc}" FontSize="12" Foreground="{DynamicResource TossGrey500Brush}" Margin="0,0,0,14" />

							<!-- 1. 마우스 감도 멀티플라이어 (MouseSensitivityMultiplierUnit) -->
							<Grid Margin="0,0,0,6">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0">
									<TextBlock Text="{DynamicResource Str_MultiplierTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TossGrey900Brush}" />
									<TextBlock Text="{Binding MultiplierHelpText}" FontSize="11" Foreground="{DynamicResource TossGrey500Brush}" TextWrapping="Wrap" Margin="0,1,0,0"/>
								</StackPanel>
								<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
									<Button Content="{DynamicResource Str_DefaultMult}" Command="{Binding SetDefaultMultiplierCommand}" Style="{StaticResource TossPillChipStyle}" Height="28" Margin="0,0,4,0"/>
									<Button Content="{DynamicResource Str_PrecisionMult}" Command="{Binding SetPrecisionMultiplierCommand}" Style="{StaticResource TossPillChipStyle}" Height="28" Margin="0,0,0,0"/>
								</StackPanel>
							</Grid>
							<TextBox Text="{Binding MouseMultiplierText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TossInputStyle}" Height="36" FontSize="13" Margin="0,0,0,16" />

							<!-- 구분선 -->
							<Border Height="1" Background="{DynamicResource TossGrey200Brush}" Margin="0,0,0,14" />

							<!-- 2. 1.0x 조준 감도 멀티플라이어 (XFactorAiming) -->
							<Grid Margin="0,0,0,6">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0">
									<TextBlock Text="{DynamicResource Str_XFactorTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TossGrey900Brush}" />
									<TextBlock Text="{DynamicResource Str_XFactorDesc}" FontSize="11" Foreground="{DynamicResource TossGrey500Brush}" TextWrapping="Wrap" Margin="0,1,0,0"/>
								</StackPanel>
								<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
									<Button Content="{DynamicResource Str_XFactorDefault}" Command="{Binding SetXFactorAimingPresetCommand}" CommandParameter="0.020000" Style="{StaticResource TossPillChipStyle}" Height="28" Margin="0,0,4,0"/>
									<Button Content="{DynamicResource Str_XFactor1to1}" Command="{Binding SetXFactorAimingPresetCommand}" CommandParameter="0.083333" Style="{StaticResource TossPillChipStyle}" Height="28" Margin="0,0,0,0"/>
								</StackPanel>
							</Grid>
							<TextBox Text="{Binding XFactorAimingText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TossInputStyle}" Height="36" FontSize="13" />

						</StackPanel>
					</Border>

				</StackPanel>

				<!-- ================= TAB 2: 동기화 · 백업 섹션 ================= -->
				<StackPanel Visibility="{Binding IsBackupTab, Converter={StaticResource BooleanToVisibilityConverter}}">

					<!-- 카드 1: 다계정 설정 일괄 동기화 -->
					<Border Style="{StaticResource TossCardBorder}">
						<StackPanel>
							<TextBlock Text="{DynamicResource Str_SyncCardTitle}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TossGrey900Brush}" Margin="0,0,0,2" />
							<TextBlock Text="{DynamicResource Str_SyncCardDesc}" FontSize="12" Foreground="{DynamicResource TossGrey500Brush}" Margin="0,0,0,10" />

							<!-- 동기화 카테고리 체크박스 그리드 -->
							<Border Background="{DynamicResource TossGrey100Brush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="Auto"/>
									</Grid.RowDefinitions>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>

									<CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding SyncInput, Mode=TwoWay}" Margin="0,2">
										<TextBlock Text="{DynamicResource Str_SyncInput}" FontSize="12" Foreground="{DynamicResource TossGrey800Brush}"/>
									</CheckBox>
									<CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding SyncColors, Mode=TwoWay}" Margin="0,2">
										<TextBlock Text="{DynamicResource Str_SyncColors}" FontSize="12" Foreground="{DynamicResource TossGrey800Brush}"/>
									</CheckBox>
									<CheckBox Grid.Row="0" Grid.Column="2" IsChecked="{Binding SyncDisplay, Mode=TwoWay}" Margin="0,2">
										<TextBlock Text="{DynamicResource Str_SyncDisplay}" FontSize="12" Foreground="{DynamicResource TossGrey800Brush}"/>
									</CheckBox>
									<CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding SyncAudio, Mode=TwoWay}" Margin="0,2">
										<TextBlock Text="{DynamicResource Str_SyncAudio}" FontSize="12" Foreground="{DynamicResource TossGrey800Brush}"/>
									</CheckBox>
									<CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding SyncGameplay, Mode=TwoWay}" Margin="0,2">
										<TextBlock Text="{DynamicResource Str_SyncGameplay}" FontSize="12" Foreground="{DynamicResource TossGrey800Brush}"/>
									</CheckBox>
									<CheckBox Grid.Row="1" Grid.Column="2" IsChecked="{Binding SyncQuality, Mode=TwoWay}" Margin="0,2">
										<TextBlock Text="{DynamicResource Str_SyncQuality}" FontSize="12" Foreground="{DynamicResource TossGrey800Brush}"/>
									</CheckBox>
								</Grid>
							</Border>

							<!-- 보조 계정 선택 안내 또는 체크박스 목록 -->
							<TextBlock Text="{DynamicResource Str_SelectTargets}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TossGrey800Brush}" Margin="0,0,0,6" />

							<!-- 보조 계정이 없을 때 안내 메시지 -->
							<Border Background="{DynamicResource TossGrey100Brush}" 
									CornerRadius="8" 
									Padding="14,10" 
									Margin="0,0,0,10"
									Visibility="{Binding HasNoSyncTargets, Converter={StaticResource BooleanToVisibilityConverter}}">
								<TextBlock Text="{DynamicResource Str_NoTargetsNotice}" 
										   FontSize="12" 
										   Foreground="{DynamicResource TossGrey600Brush}" 
										   TextWrapping="Wrap" />
							</Border>

							<!-- 보조 계정 목록이 있을 때 노출 -->
							<ItemsControl ItemsSource="{Binding SyncTargetAccounts}" 
										  Margin="0,0,0,10"
										  Visibility="{Binding HasSyncTargets, Converter={StaticResource BooleanToVisibilityConverter}}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<CheckBox IsChecked="{Binding IsSyncTarget, Mode=TwoWay}" Margin="0,2,0,4">
											<TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="{DynamicResource TossGrey800Brush}"/>
										</CheckBox>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<Button Content="{DynamicResource Str_SyncExecute}" 
									Command="{Binding SyncSelectedAccountsCommand}" 
									IsEnabled="{Binding CanModifySettings}"
									Style="{StaticResource TossSecondaryButtonStyle}" 
									Height="38" 
									HorizontalAlignment="Stretch" />
						</StackPanel>
					</Border>

					<!-- 카드 2: 설정 프리셋 백업 & 복원 -->
					<Border Style="{StaticResource TossCardBorder}">
						<StackPanel>
							<Grid Margin="0,0,0,2">
								<TextBlock Text="{DynamicResource Str_PresetCardTitle}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TossGrey900Brush}" />
								<TextBlock Text="{Binding Presets.Count, StringFormat={}{0} Presets}" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource TossGrey500Brush}" />
							</Grid>
							<TextBlock Text="{DynamicResource Str_PresetCardDesc}" FontSize="12" Foreground="{DynamicResource TossGrey500Brush}" Margin="0,0,0,10" />

							<!-- 프리셋 신규 생성 -->
							<Grid Margin="0,0,0,10">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="6" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<TextBox Grid.Column="0" Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TossInputStyle}" Height="36" FontSize="12" HorizontalContentAlignment="Left" />
								<Button Grid.Column="2" Content="{DynamicResource Str_SaveCurrentPreset}" Command="{Binding SavePresetCommand}" Style="{StaticResource TossSmallButtonStyle}" Height="36" Padding="12,0" />
							</Grid>

							<!-- 프리셋 목록 & 조작 버튼 -->
							<ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" Height="38" Margin="0,0,0,8" />

							<!-- 2x2 버튼 그리드로 창 축소 시에도 텍스트 잘림 원천 방지 -->
							<Grid Margin="0,0,0,6">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="6" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>

								<Button Grid.Row="0" Grid.Column="0" Content="{DynamicResource Str_RestorePreset}" Command="{Binding RestorePresetCommand}" IsEnabled="{Binding CanModifySettings}" Style="{StaticResource TossSecondaryButtonStyle}" Height="36" Margin="0,0,0,6" />
								<Button Grid.Row="0" Grid.Column="2" Content="{DynamicResource Str_ComparePreset}" Command="{Binding ComparePresetCommand}" Style="{StaticResource TossSmallButtonStyle}" Height="36" Margin="0,0,0,6" />
								<Button Grid.Row="1" Grid.Column="0" Content="{DynamicResource Str_ExportPreset}" Command="{Binding ExportPresetCommand}" Style="{StaticResource TossSmallButtonStyle}" Height="36" />
								<Button Grid.Row="1" Grid.Column="2" Content="{DynamicResource Str_DeletePreset}" Command="{Binding DeletePresetCommand}" Style="{StaticResource TossSmallButtonStyle}" Height="36" />
							</Grid>

							<Button Content="{DynamicResource Str_ImportPreset}" Command="{Binding ImportPresetCommand}" Style="{StaticResource TossSmallButtonStyle}" HorizontalAlignment="Stretch" Height="32" FontSize="12" />

							<!-- 프리셋 변경점 Diff (비교 시에만 노출) -->
							<Border Background="{DynamicResource TossGrey100Brush}" CornerRadius="8" Padding="10" Margin="0,10,0,0" MaxHeight="150" Visibility="{Binding HasDiffItems, Converter={StaticResource BooleanToVisibilityConverter}}">
								<ScrollViewer VerticalScrollBarVisibility="Auto">
									<ItemsControl ItemsSource="{Binding DiffItems}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Border Background="{DynamicResource TossWhiteBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,0,4">
													<Grid>
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="Auto" />
															<ColumnDefinition Width="*" />
														</Grid.ColumnDefinitions>
														<Border Grid.Column="0" Background="{DynamicResource TossBlueWeakBrush}" CornerRadius="4" Padding="4,1" Margin="0,0,6,0">
															<TextBlock Text="{Binding Section}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TossBlueBrush}" />
														</Border>
														<TextBlock Grid.Column="1" Text="{Binding DisplayDiff}" FontSize="11" Foreground="{DynamicResource TossGrey900Brush}" VerticalAlignment="Center" />
													</Grid>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</ScrollViewer>
							</Border>
						</StackPanel>
					</Border>

				</StackPanel>

				<!-- ================= TAB 3: 리플레이 보관소 섹션 ================= -->
				<StackPanel Visibility="{Binding IsReplayTab, Converter={StaticResource BooleanToVisibilityConverter}}">

					<!-- 컴팩트 리플레이 안내 가이드 -->
					<Border Background="{DynamicResource TossBlueWeakBrush}" BorderBrush="{DynamicResource TossBlueBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
						<StackPanel>
							<Grid Margin="0,0,0,4">
								<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
									<TextBlock Text="🎬" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
									<TextBlock Text="{DynamicResource Str_ReplayGuideTitle}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TossBlueBrush}" VerticalAlignment="Center" />
								</StackPanel>
								<Border Background="{DynamicResource TossWhiteBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
									<TextBlock Text="{DynamicResource Str_SafeArchive}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TossBlueBrush}" />
								</Border>
							</Grid>
							<TextBlock Text="{DynamicResource Str_ReplayGuideDesc}" 
									   FontSize="12" Foreground="{DynamicResource TossGrey800Brush}" TextWrapping="Wrap" LineHeight="17" />
						</StackPanel>
					</Border>

					<!-- 리플레이 조작 카드 -->
					<Border Style="{StaticResource TossCardBorder}">
						<StackPanel>
							<TextBlock Text="{DynamicResource Str_ReplayCardTitle}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TossGrey900Brush}" Margin="0,0,0,2" />
							<TextBlock Text="{DynamicResource Str_ReplayCardDesc}" FontSize="12" Foreground="{DynamicResource TossGrey500Brush}" Margin="0,0,0,10" />

							<!-- 경로 및 탐색기 바로가기 -->
							<Grid Margin="0,0,0,10">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="6" />
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="6" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<TextBox Grid.Column="0" Text="{Binding MatchReplayPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TossInputStyle}" Height="34" FontSize="11" HorizontalContentAlignment="Left" />
								<Button Grid.Column="2" Content="{DynamicResource Str_InGameFolder}" Command="{Binding OpenMatchReplayFolderCommand}" Style="{StaticResource TossSmallButtonStyle}" Height="34" />
								<Button Grid.Column="4" Content="{DynamicResource Str_ArchiveFolder}" Command="{Binding OpenArchiveFolderCommand}" Style="{StaticResource TossSmallButtonStyle}" Height="34" />
							</Grid>

							<!-- 1. 게임 내 활성 리플레이 목록 & 백업 -->
							<TextBlock Text="{DynamicResource Str_RecentInGameReplays}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TossGrey800Brush}" Margin="0,0,0,4" />
							<ComboBox ItemsSource="{Binding ActiveReplays}" SelectedItem="{Binding SelectedActiveReplay}" DisplayMemberPath="DisplayTitle" HorizontalAlignment="Stretch" Height="38" Margin="0,0,0,6" />
							<Button Content="{DynamicResource Str_BackupReplay}" Command="{Binding BackupSelectedReplayCommand}" Style="{StaticResource TossSecondaryButtonStyle}" Height="38" Margin="0,0,0,12" HorizontalAlignment="Stretch" />

							<!-- 구분선 -->
							<Border Height="1" Background="{DynamicResource TossGrey200Brush}" Margin="0,0,0,12" />

							<!-- 2. 영구 보관소 리플레이 목록 & 복원/삭제 -->
							<TextBlock Text="{DynamicResource Str_ArchivedReplays}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TossGrey800Brush}" Margin="0,0,0,4" />
							<ComboBox ItemsSource="{Binding ArchivedReplays}" SelectedItem="{Binding SelectedArchivedReplay}" DisplayMemberPath="DisplayTitle" HorizontalAlignment="Stretch" Height="38" Margin="0,0,0,6" />

							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="6" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<Button Grid.Column="0" Content="{DynamicResource Str_RestoreReplay}" Command="{Binding RestoreSelectedReplayCommand}" Style="{StaticResource TossSecondaryButtonStyle}" Height="38" />
								<Button Grid.Column="2" Content="{DynamicResource Str_DeleteArchivedReplay}" Command="{Binding DeleteSelectedArchivedReplayCommand}" Style="{StaticResource TossSmallButtonStyle}" Height="38" Padding="14,0" />
							</Grid>
						</StackPanel>
					</Border>

				</StackPanel>

				<!-- ================= TAB 4: 캐시 정리 섹션 (단 1개 통합 카드) ================= -->
				<StackPanel Visibility="{Binding IsCacheTab, Converter={StaticResource BooleanToVisibilityConverter}}">

					<Border Style="{StaticResource TossCardBorder}">
						<StackPanel>
							<!-- 상단 헤더 & 아웃라인 재스캔 버튼 -->
							<Grid Margin="0,0,0,6">
								<StackPanel VerticalAlignment="Center">
									<TextBlock Text="{DynamicResource Str_CacheCardTitle}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TossGrey900Brush}" />
									<TextBlock Text="{DynamicResource Str_CacheCardDesc}" FontSize="12" Foreground="{DynamicResource TossGrey500Brush}" Margin="0,1,0,0"/>
								</StackPanel>

								<Button Content="{DynamicResource Str_RescanCache}" 
										Command="{Binding ScanAllCachesCommand}" 
										Style="{StaticResource TossOutlineButtonStyle}" 
										HorizontalAlignment="Right" 
										Height="34" />
							</Grid>

							<!-- 발견된 캐시 용량 요약 배너 -->
							<Border Background="{DynamicResource TossGrey100Brush}" CornerRadius="8" Padding="12,8" Margin="0,6,0,10">
								<Grid>
									<TextBlock Text="{DynamicResource Str_CleanableCacheList}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TossGrey700Brush}" VerticalAlignment="Center"/>
									<TextBlock Text="{Binding TotalScannedCacheFormatted, StringFormat={}{0}}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TossBlueBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
								</Grid>
							</Border>

							<!-- 캐시 대상 목록 (컴팩트 카드) -->
							<Border Background="{DynamicResource TossGrey100Brush}" CornerRadius="8" Padding="8" Margin="0,0,0,12">
								<ItemsControl ItemsSource="{Binding CacheTargets}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border Background="{DynamicResource TossWhiteBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,4" BorderBrush="{DynamicResource TossGrey200Brush}" BorderThickness="1">
												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*" />
														<ColumnDefinition Width="Auto" />
													</Grid.ColumnDefinitions>
													<StackPanel Grid.Column="0">
														<CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,0,1">
															<TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TossGrey900Brush}" />
														</CheckBox>
														<TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TossGrey600Brush}" Margin="22,0,0,0" TextWrapping="Wrap" />
													</StackPanel>
													<Border Grid.Column="1" Background="{DynamicResource TossBlueWeakBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
														<TextBlock Text="{Binding FormattedSize}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TossBlueBrush}" />
													</Border>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</Border>

							<!-- 명확한 삭제 액션 버튼 -->
							<Button Content="{Binding CleanCacheButtonText}" 
									Command="{Binding CleanSelectedCachesCommand}" 
									IsEnabled="{Binding CanModifySettings}"
									Style="{StaticResource TossPrimaryButtonStyle}" 
									Height="46" 
									HorizontalAlignment="Stretch" />
						</StackPanel>
					</Border>

				</StackPanel>

			</StackPanel>
		</ScrollViewer>

		<!-- 4. Fixed Bottom CTA & Status Area -->
		<Border Grid.Row="3" 
				Background="{DynamicResource TossWhiteBrush}" 
				BorderBrush="{DynamicResource TossGrey200Brush}" 
				BorderThickness="0,1,0,0" 
				Padding="16,10,16,14">
			<StackPanel>
				<TextBlock Text="{Binding StatusMessage}" 
						   FontSize="12" 
						   Foreground="{DynamicResource TossGrey600Brush}" 
						   HorizontalAlignment="Center" 
						   Margin="0,0,0,6" />

				<Button Content="{Binding PrimaryCtaText}" 
						Command="{Binding ExecutePrimaryActionCommand}" 
						IsEnabled="{Binding CanModifySettings}"
						Style="{StaticResource TossPrimaryButtonStyle}" 
						HorizontalAlignment="Stretch" 
						Margin="0,0,0,8" />

				<!-- Quick Game Launchers (Phase 4) -->
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="8" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<Button Grid.Column="0" 
							Command="{Binding LaunchSteamGameCommand}" 
							Style="{StaticResource TossSecondaryButtonStyle}" 
							Height="38">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="🎮" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
							<TextBlock Text="{DynamicResource Str_LaunchSteam}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
						</StackPanel>
					</Button>

					<Button Grid.Column="2" 
							Command="{Binding LaunchUbisoftGameCommand}" 
							Style="{StaticResource TossSecondaryButtonStyle}" 
							Height="38">
						<StackPanel Orientation="Horizontal">
